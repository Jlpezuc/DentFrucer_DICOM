rules_version = '2';

// DentFrucer — reglas de Storage.
// Archivos en studies/{studyId}/...: los sube, borra y lee un administrador con
// el permiso "Exámenes" (o el administrador general); también los lee el médico
// asignado al examen en Firestore (doctorIds, o doctorId en exámenes anteriores).
// Las demás cuentas de administración no abren imágenes ni informes.
service firebase.storage {
  match /b/{bucket}/o {
    function user() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && user().role == 'admin' && user().get('disabled', false) != true;
    }
    function canExams() {
      return isAdmin() && (user().get('superadmin', false) == true || !('permissions' in user())
        || user().permissions.get('examenes', false) == true);
    }
    function isStudyDoctor(studyId) {
      let s = firestore.get(/databases/(default)/documents/studies/$(studyId)).data;
      return s.get('doctorId', null) == request.auth.uid || request.auth.uid in s.get('doctorIds', []);
    }

    match /studies/{studyId}/{allPaths=**} {
      allow read: if request.auth != null && (canExams() || isStudyDoctor(studyId));
      allow write: if canExams();
    }
  }
}
