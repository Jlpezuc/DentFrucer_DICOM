rules_version = '2';

// DentFrucer — reglas de Firestore.
// - Administradores (users/{uid}.role == 'admin', no desactivados): leen los
//   datos de la clínica; para modificar cada parte necesitan su permiso
//   (users/{uid}.permissions: agenda, examenes, pacientes, medicos, cobros,
//   resumen, config). El administrador general (superadmin, o una cuenta sin
//   mapa de permisos, como el primer administrador) puede todo y es el único
//   que crea y edita cuentas de administración.
// - Médicos: solo leen sus exámenes (su uid en studies.doctorIds, o en
//   studies.doctorId en exámenes anteriores) y solo pueden marcarlos como
//   'Visto'. Los datos del paciente que necesitan van copiados en el examen; la
//   colección de pacientes es solo de la clínica.
// - Público (agendar.html, sin cuenta): puede CREAR una cita, su turno y el
//   paciente, con campos validados, y leer los servicios y el horario
//   (settings). No puede leer, cambiar ni borrar nada más; solo ve qué turnos
//   están ocupados (colección "slots", sin datos personales).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && me().role == 'admin' && me().get('disabled', false) != true;
    }
    // Administrador general: superadmin, o cuenta sin mapa de permisos (la primera).
    function isSuper() {
      return isAdmin() && (me().get('superadmin', false) == true || !('permissions' in me()));
    }
    function can(p) {
      return isAdmin() && (isSuper() || me().permissions.get(p, false) == true);
    }
    function ownsRecord(data) {
      return signedIn()
        && (data.get('doctorId', null) == request.auth.uid || request.auth.uid in data.get('doctorIds', []));
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Servicios que el público puede agendar: los activos guardados desde el panel
    // o, si todavía no se guardó nada, los de config/agenda-config.js.
    function bookableExam(exam) {
      return exists(/databases/$(database)/documents/settings/agenda)
        ? exam in get(/databases/$(database)/documents/settings/agenda).data.examIds
        : exam in ['CBCT', 'Panorámica', 'Cefalometría', 'Periapical', 'Otro'];
    }

    // --- Validación de lo que llega desde la agenda pública ---------------------
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function validEmail(v) {
      return v is string && v.size() <= 120 && (v == '' || v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'));
    }
    function validPerson(d) {
      return text(d.firstName, 1, 60) && text(d.lastName, 1, 60) && text(d.name, 3, 121)
        && validEmail(d.email) && text(d.phone, 0, 30);
    }
    function validSlotKey(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$');
    }
    function slotPath(id) {
      return /databases/$(database)/documents/slots/$(id);
    }
    function appointmentPath(id) {
      return /databases/$(database)/documents/appointments/$(id);
    }

    // Cuentas. Médicos: los crea quien tiene el permiso "medicos". Administradores:
    // solo el administrador general, que no puede cambiarse a sí mismo el rol, los
    // permisos ni desactivarse. Cada cuenta puede cambiar su propio nombre.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSuper() || (can('medicos') && request.resource.data.role == 'doctor');
      allow update: if (isSuper()
            && !(uid == request.auth.uid && changes().hasAny(['role', 'superadmin', 'permissions', 'disabled'])))
        || (can('medicos') && resource.data.role == 'doctor' && request.resource.data.role == 'doctor')
        || (uid == request.auth.uid && changes().hasOnly(['name']));
      allow delete: if isSuper() && uid != request.auth.uid;
    }

    // Servicios y horario de la agenda: públicos (los usa agendar.html).
    match /settings/{id} {
      allow read: if true;
      allow write: if can('config') && request.resource.data.examIds is list;
    }

    // Cobros: los ve quien tiene "cobros" o "resumen"; los modifica "cobros".
    match /payments/{paymentId} {
      allow read: if can('cobros') || can('resumen');
      allow create, update, delete: if can('cobros');
    }

    // Pacientes: solo identidad y contacto. No tienen médico: el médico se
    // asigna a cada examen.
    match /patients/{patientId} {
      allow read: if isAdmin();
      allow update, delete: if can('pacientes');
      // Paciente creado al agendar: sin expediente ni edad (los completa la clínica).
      allow create: if can('pacientes') || can('agenda') || (
        request.resource.data.keys().hasOnly(['name', 'firstName', 'lastName', 'email', 'phone', 'code', 'age', 'source', 'createdAt'])
        && validPerson(request.resource.data)
        && request.resource.data.code == ''
        && request.resource.data.age == null
        && request.resource.data.source == 'agenda'
        && request.resource.data.createdAt == request.time
      );
    }

    match /studies/{studyId} {
      allow read: if isAdmin() || ownsRecord(resource.data);
      allow create, delete: if can('examenes');
      allow update: if can('examenes')
        // Al editar un paciente se actualizan sus datos copiados en los exámenes.
        || (can('pacientes') && changes().hasOnly(['patientName', 'patientCode', 'patientAge']))
        || (ownsRecord(resource.data) && changes().hasOnly(['status']) && request.resource.data.status == 'Visto');
    }

    // Citas: datos personales, solo los ve la clínica.
    match /appointments/{appointmentId} {
      allow read: if isAdmin();
      allow delete: if can('agenda');
      // Quien carga exámenes marca la cita como atendida.
      allow update: if can('agenda') || (can('examenes') && changes().hasOnly(['status']));
      allow create: if can('agenda') || (
        request.resource.data.keys().hasOnly(['code', 'firstName', 'lastName', 'name', 'email', 'phone', 'referrer', 'exam', 'date', 'time', 'slotId', 'patientId', 'status', 'createdAt'])
        && validPerson(request.resource.data)
        && text(request.resource.data.referrer, 0, 80)
        && validSlotKey(request.resource.data)
        && text(request.resource.data.code, 1, 12)
        && bookableExam(request.resource.data.exam)
        && request.resource.data.status == 'Pendiente'
        && request.resource.data.createdAt == request.time
        && request.resource.data.slotId == request.resource.data.date + '_' + request.resource.data.time.replace(':', '')
        && text(request.resource.data.patientId, 1, 64)
        // El turno se ocupa en la misma operación y apunta a esta cita.
        && getAfter(slotPath(request.resource.data.slotId)).data.appointmentId == appointmentId
        && existsAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId))
      );
    }

    // Turnos ocupados: el ID es "fecha_hora", así que un turno no se puede
    // reservar dos veces (crear sobre uno existente no está permitido).
    match /slots/{slotKey} {
      allow read: if true;
      allow delete: if can('agenda');
      allow create: if can('agenda') || (
        request.resource.data.keys().hasOnly(['date', 'time', 'appointmentId'])
        && validSlotKey(request.resource.data)
        && slotKey == request.resource.data.date + '_' + request.resource.data.time.replace(':', '')
        && request.resource.data.appointmentId is string
        && getAfter(appointmentPath(request.resource.data.appointmentId)).data.slotId == slotKey
      );
    }
  }
}
